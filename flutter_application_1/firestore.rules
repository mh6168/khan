rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMasterDealer() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'masterDealer';
    }

    function reservationOrderPath(orderId) {
      return /databases/$(database)/documents/jewelryReservationOrders/$(orderId);
    }

    function reservationPath(reservationId) {
      return /databases/$(database)/documents/jewelryReservations/$(reservationId);
    }

    function reservationPaymentPath(paymentId) {
      return /databases/$(database)/documents/jewelryReservationPayments/$(paymentId);
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'uid',
          'createdAt'
        ]);
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phone'
        ]);
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow get: if request.auth != null
        && (request.auth.uid == applicationId
          || resource.data.status == 'approved');
    }

    match /products/{productId} {
      allow get: if request.auth != null
        && (
          resource.data.availability == 'available'
          || (
            resource.data.reservationLockOrderId is string
            && get(
              reservationOrderPath(resource.data.reservationLockOrderId)
            ).data.customerUid == request.auth.uid
          )
          || (
            resource.data.availability == 'reserved_pending'
            && resource.data.reservationLockExpiresAt is timestamp
            && resource.data.reservationLockExpiresAt <= request.time
          )
        );
      allow list: if request.auth != null
        && resource.data.availability == 'available';
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availability',
          'reservationLockOrderId',
          'reservationLockExpiresAt',
          'activeReservationId',
          'reservedAt',
          'reservedUntil',
          'reservationStatus',
          'updatedAt'
        ])
        && (
          (
            resource.data.availability == 'available'
            && request.resource.data.availability == 'reserved_pending'
            && request.resource.data.reservationLockOrderId is string
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.customerUid == request.auth.uid
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.productId == productId
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.status == 'pending'
          )
          || (
            resource.data.availability == 'reserved_pending'
            && request.resource.data.availability == 'reserved_pending'
            && resource.data.reservationLockExpiresAt is timestamp
            && resource.data.reservationLockExpiresAt <= request.time
            && resource.data.reservationLockOrderId is string
            && (
              !exists(reservationOrderPath(
                resource.data.reservationLockOrderId
              ))
              || getAfter(
                reservationOrderPath(resource.data.reservationLockOrderId)
              ).data.status in ['expired', 'cancelled']
            )
            && request.resource.data.reservationLockOrderId is string
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.customerUid == request.auth.uid
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.productId == productId
            && getAfter(
              reservationOrderPath(
                request.resource.data.reservationLockOrderId
              )
            ).data.status == 'pending'
          )
          || (
            resource.data.availability == 'reserved_pending'
            && request.resource.data.availability == 'unavailable'
            && request.resource.data.activeReservationId
              == resource.data.reservationLockOrderId
            && getAfter(
              reservationOrderPath(resource.data.reservationLockOrderId)
            ).data.customerUid == request.auth.uid
            && getAfter(
              reservationOrderPath(resource.data.reservationLockOrderId)
            ).data.status == 'completed'
            && getAfter(
              reservationPath(resource.data.reservationLockOrderId)
            ).data.customerUid == request.auth.uid
          )
          || (
            resource.data.availability == 'reserved_pending'
            && request.resource.data.availability == 'available'
            && getAfter(
              reservationOrderPath(resource.data.reservationLockOrderId)
            ).data.customerUid == request.auth.uid
            && getAfter(
              reservationOrderPath(resource.data.reservationLockOrderId)
            ).data.status == 'cancelled'
          )
        );
      allow create, delete: if false;
    }

    match /jewelryReservations/{reservationId} {
      allow get: if request.auth != null
        && (
          !exists(reservationPath(reservationId))
          || resource.data.customerUid == request.auth.uid
        );
      allow list: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.reservationId == reservationId
        && request.resource.data.status == 'reserved_for_48_hours'
        && getAfter(reservationOrderPath(reservationId)).data.customerUid
          == request.auth.uid
        && getAfter(reservationOrderPath(reservationId)).data.status
          == 'completed'
        && getAfter(reservationOrderPath(reservationId)).data.paymobTransactionId
          == request.resource.data.paymobTransactionId
        && request.resource.data.productId
          == getAfter(reservationOrderPath(reservationId)).data.productId
        && request.resource.data.depositAmountMinorUnits
          == getAfter(reservationOrderPath(reservationId)).data.depositAmountMinorUnits;
      allow update: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'reserved_for_48_hours'
        && request.time >= resource.data.reservationExpiresAt
        && request.resource.data.status == 'user_didnt_pick_up'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);
      allow delete: if false;
    }

    match /jewelryReservationOrders/{orderId} {
      allow get: if request.auth != null
        && (
          !exists(reservationOrderPath(orderId))
          || resource.data.customerUid == request.auth.uid
          || (
            resource.data.status == 'pending'
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt <= request.time
          )
        );
      allow list: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.currency == 'EGP'
        && request.resource.data.paymentGateway == 'paymob'
        && request.resource.data.totalPriceMinorUnits is int
        && request.resource.data.totalPriceMinorUnits > 0
        && request.resource.data.depositAmountMinorUnits is int
        && request.resource.data.depositAmountMinorUnits > 0
        && request.resource.data.remainingBalanceMinorUnits
          == request.resource.data.totalPriceMinorUnits
            - request.resource.data.depositAmountMinorUnits
        && request.resource.data.keys().hasOnly([
          'orderId',
          'customerUid',
          'customerName',
          'customerEmail',
          'customerPhone',
          'productId',
          'productName',
          'productImagePath',
          'jewelerId',
          'jewelerStoreName',
          'totalPriceMinorUnits',
          'depositAmountMinorUnits',
          'remainingBalanceMinorUnits',
          'currency',
          'paymentGateway',
          'status',
          'createdAt',
          'expiresAt',
          'merchantOrderId'
        ]);
      allow update: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'pending'
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paymobOrderId'])
          )
          || (
            request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt'])
          )
          || (
            request.resource.data.status == 'expired'
            && request.time >= resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'expiredAt'])
          )
          || (
            request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'reservationId',
                'paymobTransactionId',
                'paymentTransactionId',
                'paidAt',
                'completedAt'
              ])
            && getAfter(reservationPath(orderId)).data.customerUid
              == request.auth.uid
            && getAfter(reservationPath(orderId)).data.paymobTransactionId
              == request.resource.data.paymobTransactionId
            && getAfter(reservationPaymentPath(
              'payment-' + request.resource.data.paymobTransactionId
            )).data.reservationOrderId == orderId
          )
        );
      allow delete: if false;
    }

    match /jewelryReservationPayments/{paymentId} {
      allow get: if request.auth != null
        && (
          !exists(reservationPaymentPath(paymentId))
          || resource.data.customerUid == request.auth.uid
        );
      allow list: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && getAfter(
          reservationOrderPath(request.resource.data.reservationOrderId)
        ).data.status == 'completed'
        && getAfter(
          reservationOrderPath(request.resource.data.reservationOrderId)
        ).data.paymobTransactionId
          == request.resource.data.paymobTransactionId
        && request.resource.data.keys().hasOnly([
          'reservationOrderId',
          'reservationId',
          'customerUid',
          'paymobTransactionId',
          'paymobOrderId',
          'amountMinorUnits',
          'currency',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /masterDealerInventory/{assetId} {
      allow read: if request.auth != null;
      // Client writes support the Spark-plan investment demo workflows.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity',
          'reserved',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.reserved is int
        && request.resource.data.quantity >= 0
        && request.resource.data.reserved >= 0
        && request.resource.data.reserved <= request.resource.data.quantity
        && (
          (
            isMasterDealer()
            && request.resource.data.quantity >= resource.data.quantity
            && request.resource.data.reserved == resource.data.reserved
          )
          || request.resource.data.quantity <= resource.data.quantity
        );
    }

    match /masterDealerPrices/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerPriceHistory/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerTransactions/{transactionId} {
      allow read: if request.auth != null
        && resource.data.status == 'completed'
        && (
          resource.data.customerUid == request.auth.uid
          || isMasterDealer()
        );
      allow create: if (
        request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.type == 'customer_purchase'
        && request.resource.data.status == 'completed'
        && request.resource.data.source == 'paymob'
        && request.resource.data.keys().hasOnly([
          'type',
          'status',
          'source',
          'customerUid',
          'purchaseOrderId',
          'paymentTransactionId',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'amountMinorUnits',
          'createdAt'
        ])
      ) || (
        isMasterDealer()
        && request.resource.data.type == 'customer_buyback'
        && request.resource.data.status == 'completed'
        && request.resource.data.source == 'instapay'
        && request.resource.data.keys().hasOnly([
          'type',
          'status',
          'source',
          'customerUid',
          'buybackRequestId',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'amountMinorUnits',
          'createdAt',
          'confirmedAt'
        ])
      );
    }

    match /masterDealerSellRequests/{requestId} {
      allow read: if request.auth != null
        && (
          resource.data.customerUid == request.auth.uid
          || isMasterDealer()
        );
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'customerName',
          'customerEmail',
          'customerPhone',
          'instapayPhone',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'totalPayoutMinor',
          'currency',
          'status',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerEmail is string
        && request.resource.data.customerPhone is string
        && request.resource.data.instapayPhone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.liraQuantity is int
        && request.resource.data.paraQuantity is int
        && request.resource.data.liraQuantity >= 0
        && request.resource.data.paraQuantity >= 0
        && request.resource.data.liraQuantity <= 10000
        && request.resource.data.paraQuantity <= 10000
        && (
          request.resource.data.liraQuantity > 0
          || request.resource.data.paraQuantity > 0
        )
        && request.resource.data.liraUnitPriceMinor is int
        && request.resource.data.paraUnitPriceMinor is int
        && request.resource.data.liraUnitPriceMinor > 0
        && request.resource.data.paraUnitPriceMinor > 0
        && request.resource.data.totalPayoutMinor
          == request.resource.data.liraQuantity
            * request.resource.data.liraUnitPriceMinor
          + request.resource.data.paraQuantity
            * request.resource.data.paraUnitPriceMinor
        && request.resource.data.currency == 'EGP'
        && request.resource.data.status == 'processing'
        && request.resource.data.createdAt is timestamp;
      allow update: if isMasterDealer()
        && resource.data.status == 'processing'
        && request.resource.data.status == 'money_transferred'
        && request.resource.data.transferredAt is timestamp
        && request.resource.data.transferredBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'transferredAt',
          'transferredBy'
        ]);
      allow delete: if false;
    }

    match /masterDealerPurchaseOrders/{orderId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'amountMinorUnits',
          'currency',
          'status',
          'createdAt',
          'expiresAt',
          'merchantOrderId'
        ]);
      allow update: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymobOrderId',
          'status',
          'paymentTransactionId',
          'paidAt',
          'cancelledAt'
        ])
        && (
          request.resource.data.status == 'pending'
          || request.resource.data.status == 'completed'
          || request.resource.data.status == 'cancelled'
        );
    }

    match /customerPortfolios/{customerId} {
      allow read: if request.auth != null
        && (request.auth.uid == customerId || isMasterDealer());
      allow create, update: if request.auth != null
        && (request.auth.uid == customerId || isMasterDealer())
        && request.resource.data.keys().hasOnly([
          'liraQuantity',
          'paraQuantity',
          'reservedLiraQuantity',
          'reservedParaQuantity',
          'updatedAt'
        ])
        && request.resource.data.liraQuantity is int
        && request.resource.data.paraQuantity is int
        && request.resource.data.liraQuantity >= 0
        && request.resource.data.paraQuantity >= 0
        && (
          !('reservedLiraQuantity' in request.resource.data.keys())
          || (
            request.resource.data.reservedLiraQuantity is int
            && request.resource.data.reservedLiraQuantity >= 0
            && request.resource.data.reservedLiraQuantity
              <= request.resource.data.liraQuantity
          )
        )
        && (
          !('reservedParaQuantity' in request.resource.data.keys())
          || (
            request.resource.data.reservedParaQuantity is int
            && request.resource.data.reservedParaQuantity >= 0
            && request.resource.data.reservedParaQuantity
              <= request.resource.data.paraQuantity
          )
        );
    }
  }
}
