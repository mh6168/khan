rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'uid',
          'createdAt'
        ]);
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phone'
        ]);
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow get: if request.auth != null
        && (request.auth.uid == applicationId
          || resource.data.status == 'approved');
    }

    match /products/{productId} {
      allow read: if request.auth != null
        && resource.data.availability == 'available';
      allow write: if false;
    }

    match /masterDealerInventory/{assetId} {
      allow read: if request.auth != null;
      // Client writes are enabled only for the university demo checkout.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity',
          'reserved',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.reserved is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= resource.data.quantity
        && request.resource.data.reserved >= 0
        && request.resource.data.reserved <= request.resource.data.quantity;
    }

    match /masterDealerPrices/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerPriceHistory/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerTransactions/{transactionId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'completed';
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.type == 'customer_purchase'
        && request.resource.data.status == 'completed'
        && request.resource.data.source == 'paymob'
        && request.resource.data.keys().hasOnly([
          'type',
          'status',
          'source',
          'customerUid',
          'purchaseOrderId',
          'paymentTransactionId',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'amountMinorUnits',
          'createdAt'
        ]);
    }

    match /masterDealerPurchaseOrders/{orderId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'liraQuantity',
          'paraQuantity',
          'liraUnitPriceMinor',
          'paraUnitPriceMinor',
          'amountMinorUnits',
          'currency',
          'status',
          'createdAt',
          'expiresAt',
          'merchantOrderId'
        ]);
      allow update: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymobOrderId',
          'status',
          'paymentTransactionId',
          'paidAt',
          'cancelledAt'
        ])
        && (
          request.resource.data.status == 'pending'
          || request.resource.data.status == 'completed'
          || request.resource.data.status == 'cancelled'
        );
    }

    match /customerPortfolios/{customerId} {
      allow read: if request.auth != null && request.auth.uid == customerId;
      allow create, update: if request.auth != null
        && request.auth.uid == customerId
        && request.resource.data.keys().hasOnly([
          'liraQuantity',
          'paraQuantity',
          'updatedAt'
        ])
        && request.resource.data.liraQuantity is int
        && request.resource.data.paraQuantity is int
        && request.resource.data.liraQuantity >= 0
        && request.resource.data.paraQuantity >= 0;
    }
  }
}
