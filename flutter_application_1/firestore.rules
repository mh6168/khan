rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'uid',
          'createdAt'
        ]);
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phone'
        ]);
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow get: if request.auth != null
        && (request.auth.uid == applicationId
          || resource.data.status == 'approved');
    }

    match /products/{productId} {
      allow read: if request.auth != null
        && resource.data.availability == 'available';
      allow write: if false;
    }

    match /masterDealerInventory/{assetId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerPrices/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerPriceHistory/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /masterDealerTransactions/{transactionId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'completed';
      allow write: if false;
    }

    match /masterDealerPurchaseOrders/{orderId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }

    match /customerPortfolios/{customerId} {
      allow read: if request.auth != null && request.auth.uid == customerId;
      allow write: if false;
    }
  }
}
